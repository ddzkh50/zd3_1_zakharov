<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Основная кнопка -->
    <style name="TvPrimaryButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:background">@drawable/bt</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- Поле ввода -->
    <style name="TvInputField">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">18dp</item>
        <item name="android:backgroundTint">@color/edit</item>
        <item name="android:textCursorDrawable">@drawable/cursor</item>
        <item name="android:textColor">@color/aquamarine</item>
        <item name="android:textColorHighlight">@color/aquamarine</item>
        <item name="android:textColorHint">@color/hint</item>
        <item name="android:textSize">16sp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
</resources>
